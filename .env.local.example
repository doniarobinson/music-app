# Copy this file to .env.local and fill in real values. Never commit .env.local.

# From your app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Spotify app.
# Local dev: Spotify requires 127.0.0.1, not localhost.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# From https://www.last.fm/api/account/create (free, non-commercial use)
LASTFM_API_KEY=

# Any long random string — used to encrypt the session cookie. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=
